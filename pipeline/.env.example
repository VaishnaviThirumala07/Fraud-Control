# Copy this file to .env and fill in your keys.
OPENAI_API_KEY=sk-proj-your-key-here
GEMINI_API_KEY=your-gemini-key-here

# ── Daytona Credit Preservation ──────────────────────────────────────────────
# Set MOCK_LLM=true during routine UI/frontend dev to use $0 in LLM API credits.
# Set MOCK_LLM=false during live hackathon demos for full GPT-4o / Gemini reasoning.
MOCK_LLM=false

# ── Streaming Configuration ───────────────────────────────────────────────────
# Time in seconds between transactions streamed by producer.py (default: 25)
TRANSACTION_INTERVAL=25

# ── Infrastructure Configuration ──────────────────────────────────────────────
KAFKA_BROKER=localhost:9092
KAFKA_TOPIC=transactions-in

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=fraudcontrol

# Optional Model Overrides
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small
